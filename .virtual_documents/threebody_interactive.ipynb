# ======================
# State containers
# ======================
orbits = []     # static artists for each clicked orbit
current_animation = {"ani": None, "artists": []}
out = Output()

def stop_current_animation():
    ani = current_animation["ani"]
    if ani is not None:
        try:
            ani.event_source.stop()
        except Exception:
            pass
    for art in current_animation["artists"]:
        try:
            art.remove()
        except Exception:
            pass
    current_animation["ani"] = None
    current_animation["artists"] = []
    fig.canvas.draw_idle()

def animate_orbit(xy, dphi, dr, trail, rot_trail, color, frame_step=2):
    """Planet and test particle moving in the inertial frame, and the particle in the co-rotating frame."""
    stop_current_animation()
    planet_dot, = ax_xy.plot([], [], 'o', color='k', markersize=6)
    particle_dot, = ax_xy.plot([], [], 'o', color=color, markersize=5)
    planet_trail, = ax_xy.plot([], [], '-', color='k', lw=0.8, alpha=0.5)
    particle_trail, = ax_xy.plot([], [], '-', color=color, lw=0.8)
    rot_trail_line, = ax_rot.plot([], [], '-', color=color, lw=1.2)
    rot_dot, = ax_rot.plot([], [], 'o', color=color, markersize=7, markeredgecolor='k')
    artists = (planet_dot, particle_dot, planet_trail, particle_trail, rot_trail_line, rot_dot)
    current_animation["artists"] = list(artists)

    def update(i):
        lo = max(0, i - trail)
        planet_dot.set_data([xy[i, 1, 0]], [xy[i, 1, 1]])
        particle_dot.set_data([xy[i, 2, 0]], [xy[i, 2, 1]])
        planet_trail.set_data(xy[lo:i+1, 1, 0], xy[lo:i+1, 1, 1])
        particle_trail.set_data(xy[lo:i+1, 2, 0], xy[lo:i+1, 2, 1])
        lo_rot = max(0, i - rot_trail)
        rot_trail_line.set_data(*break_wraps(dphi[lo_rot:i+1], dr[lo_rot:i+1]))
        rot_dot.set_data([dphi[i]], [dr[i]])
        return artists

    ani = FuncAnimation(fig, update, frames=range(0, len(dphi), frame_step),
                        interval=20, blit=True, repeat=False)
    current_animation["ani"] = ani
    return ani

# ======================
# Click handler
# ======================
def on_click(event):
    if event.inaxes != ax_sec or event.xdata is None:
        return
    theta0, ar0 = float(event.xdata), float(event.ydata)
    with out:
        if eccentricity_for(ar0) is None:
            print(f"a_r = {ar0:.3f} is below the section's C = K - I surface; click higher.")
            return
        color = plt.cm.tab10.colors[len(orbits) % 10]
        artists = []

        try:
            n, theta_map, ar_map = run_namouni(theta0, ar0, Nconj)
        except RuntimeWarning as e:
            print(f"Namouni map failed from theta={theta0:.3f}, a_r={ar0:.3f}: {e}")
            return
        artists += ax_sec.plot(theta_map, ar_map, '.', color=color, markersize=2)
        artists += ax_ar.plot(n, ar_map, '-', color=color, lw=1)

        xy, theta_nb, ar_nb, orbits_per_conj = run_nbody(theta0, ar0, Nconj)
        artists += ax_sec.plot(theta_nb, ar_nb, 'x', color=color, markersize=3, mew=0.6)
        artists += ax_ar.plot(np.arange(len(ar_nb)), ar_nb, '--', color=color, lw=1)

        # static path: the first conjunction; the animation trails the most recent one
        dphi, dr = rotating_frame(xy)
        rot_trail = int(orbits_per_conj*samples_per_orbit)
        artists += ax_rot.plot(*break_wraps(dphi[:rot_trail], dr[:rot_trail]), '-', color=color, lw=0.6, alpha=0.4)
        ax_rot.relim(); ax_rot.autoscale_view(scalex=False)
        ax_ar.relim(); ax_ar.autoscale_view()
        orbits.append(artists)
        fig.canvas.draw_idle()

        animate_orbit(xy, dphi, dr, trail=samples_per_orbit, rot_trail=rot_trail, color=color)
        print(f"Orbit {len(orbits)}: theta0={theta0:.3f}, a_r0={ar0:.3f}, e0={eccentricity_for(ar0)/epsilon:.2f} Hill")

cid = fig.canvas.mpl_connect('button_press_event', on_click)

